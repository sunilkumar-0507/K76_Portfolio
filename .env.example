# Copy to .env and fill in before building.

# Contact form endpoint. Receives a JSON POST:
# { name, email, phone, company, service, message, source }
# Works out of the box with Formspree (https://formspree.io/f/xxxx),
# Web3Forms (https://api.web3forms.com/submit + access key) or your own API.
# If left empty, the form falls back to opening a pre-filled email — it never fakes success.
VITE_CONTACT_ENDPOINT=

# Only for Web3Forms (or any service that expects `access_key` in the body).
VITE_CONTACT_ACCESS_KEY=

# Canonical site origin for SEO tags.
VITE_SITE_URL=https://k76.in
